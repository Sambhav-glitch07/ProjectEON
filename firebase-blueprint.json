{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authorized single owner profile for Project EON.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "isOwner": { "type": "boolean" },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "isOwner", "createdAt"]
    },
    "MemoryRecord": {
      "title": "MemoryRecord",
      "description": "Cognitive memory node stored in EON Memory (episodic, semantic, preference, decision, correction).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["episodic", "semantic", "preference", "decision", "correction"] },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 10000 },
        "confidence": { "type": "number" },
        "provenance": { "type": "string", "maxLength": 512 },
        "approved": { "type": "boolean" },
        "tags": { "type": "string", "maxLength": 512 },
        "vectorHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "category", "title", "content", "confidence", "approved", "createdAt"]
    },
    "EvolutionProposal": {
      "title": "EvolutionProposal",
      "description": "Codebase evolution proposal generated by EON Evolve engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 4096 },
        "targetFile": { "type": "string", "maxLength": 256 },
        "diff": { "type": "string", "maxLength": 30000 },
        "proposedCode": { "type": "string", "maxLength": 30000 },
        "originalCode": { "type": "string", "maxLength": 30000 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "riskScore": { "type": "number" },
        "status": { "type": "string", "enum": ["proposed", "testing", "approved", "rejected", "applied", "reverted"] },
        "testResults": { "type": "string", "maxLength": 10000 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "appliedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "title", "targetFile", "riskLevel", "status", "createdAt"]
    },
    "LabExperiment": {
      "title": "LabExperiment",
      "description": "Scientific hypothesis testing in EON Lab.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "hypothesis": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["draft", "running", "completed", "archived"] },
        "controlConfig": { "type": "string", "maxLength": 4096 },
        "experimentalConfig": { "type": "string", "maxLength": 4096 },
        "metrics": { "type": "string", "maxLength": 4096 },
        "results": { "type": "string", "maxLength": 10000 },
        "conclusion": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "hypothesis", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Tamper-evident system audit log entry for EON Guard.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "subsystem": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 4096 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "previousHash": { "type": "string", "maxLength": 128 },
        "entryHash": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "action", "subsystem", "severity", "entryHash", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Single-owner identity and profile validation"
    },
    "/memories/{memoryId}": {
      "schema": "MemoryRecord",
      "description": "EON Mind and EON Memory cognitive data"
    },
    "/evolution_proposals/{proposalId}": {
      "schema": "EvolutionProposal",
      "description": "EON Evolve software patch proposals and human authorization audit"
    },
    "/lab_experiments/{experimentId}": {
      "schema": "LabExperiment",
      "description": "EON Lab research hypotheses and experimental evaluation results"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "EON Guard security audit log stream"
    }
  }
}
